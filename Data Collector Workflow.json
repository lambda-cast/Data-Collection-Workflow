{
  "name": "iSolarCloud Data Collector (Postgres + Weather)",
  "nodes": [
    {
      "parameters": {
        "jsCode": "// Extract data from all plants\nconst plants = $input.first().json.plants;\nconst timestamp = $input.first().json.timestamp;\nconst results = [];\n\nfor (const [plantId, data] of Object.entries(plants)) {\n  results.push({\n    timestamp: timestamp,\n    plant_id: plantId,\n    power_w: parseFloat(data.power?.value || 0),\n    daily_yield_wh: parseFloat(data.daily_yield?.value || 0),\n    total_yield_wh: parseFloat(data.total_yield?.value || 0),\n    meter_ac_power_w: parseFloat(data.meter_ac_power?.value || 0),\n    load_power_w: parseFloat(data.load_power?.value || 0),\n    feed_in_energy_total_wh: parseFloat(data.feed_in_energy_total?.value || 0),\n    total_purchased_energy_wh: parseFloat(data.total_purchased_energy?.value || 0)\n  });\n}\n\nreturn results;"
      },
      "id": "98042229-d09d-4057-89fa-f765dadcfa43",
      "name": "Extract Plant Data3",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        -32
      ]
    },
    {
      "parameters": {
        "jsCode": "// Combine the weather reading and air-quality reading into one flat object.\n// Field names here match the solar_weather_data table columns 1:1.\nconst weather = $('GET Weather Data').first().json.current;\nconst aq = $input.first().json.current;\n\nreturn [{\n  json: {\n    solar_radiation_wm2: weather.shortwave_radiation,\n    outdoor_temp_c: weather.temperature_2m,\n    dew_point_c: weather.dew_point_2m,\n    wind_speed_ms: weather.wind_speed_10m,\n    wind_dir_deg: weather.wind_direction_10m,\n    humidity_pct: weather.relative_humidity_2m,\n    rain_mm: weather.rain,\n    pm25_ugm3: aq.pm2_5,\n    pm10_ugm3: aq.pm10\n  }\n}];"
      },
      "id": "44df59c7-3ae7-4684-8718-88f48f65caff",
      "name": "Combine Weather And AQ",
